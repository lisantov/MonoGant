{
  "name": "frontend-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@pinia/colada": "^0.21.7",
    "@tailwindcss/vite": "^4.3.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "maska": "^3.2.1",
    "notivue": "^2.4.5",
    "pinia": "^3.0.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "~10.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.104.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx,vue}": "eslint --fix",
    "src/**/*.{css,html,js,json,md,scss,ts,tsx,vue}": "prettier --write"
  }
}
